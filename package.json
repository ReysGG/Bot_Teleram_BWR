{
  "name": "independent-telegram-store",
  "version": "1.0.0",
  "description": "Independent Telegram store for encrypted digital file inventory",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "hash-password": "node scripts/hash-password.mjs",
    "admin:secure-password": "node scripts/secure-admin-password.mjs --env=.env.docker",
    "docker:config": "docker compose --env-file .env.docker config",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f app",
    "telegram:configure": "node scripts/configure-telegram-bot.mjs --env=.env.docker",
    "telegram:webhook": "node scripts/configure-telegram-bot.mjs --env=.env.docker --webhook",
    "qris:import-payload": "node scripts/import-qris-payload.mjs --env=.env.docker",
    "android:configure-bridge": "node scripts/configure-android-bridge.mjs --env=.env.docker",
    "android:test-bridge": "node scripts/test-android-bridge.mjs"
  },
  "keywords": [
    "telegram",
    "digital-store"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.1.5",
    "9router": "^0.5.55",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.12.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
