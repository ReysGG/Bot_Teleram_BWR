model BinanceWebTransaction {
  id                              String                         @id @default(cuid())
  sessionId                       String
  session                         BinanceWebSession              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  accountFingerprint              String
  providerTransactionId           String
  providerOrderId                 String?
  transactionType                 String?
  direction                       String
  providerStatus                  String
  providerStatusDetail            String?
  currency                        String
  amountMicros                    BigInt
  counterpartyName                String?
  viaAccountValue                 String?
  receiverBinanceId               String?
  occurredAt                      DateTime
  rawPayloadHash                  String
  detailPayloadHash               String?
