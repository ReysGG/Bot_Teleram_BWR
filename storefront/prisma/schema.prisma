// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum BannedStockPolicy {
  BLOCKED
  ALLOW_HTTP_401
  OWNER_APPROVAL
  RELOGIN_REQUIRED
}

enum DigitalStockStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  BANNED
  DISABLED
}

enum StockHealthStatus {
  UNKNOWN
  HEALTHY
  BANNED
  ERROR
}

enum BotSessionState {
  BROWSING
  AWAITING_EMAIL
  AWAITING_QUANTITY
  AWAITING_PRODUCT_SEARCH
  AWAITING_SMS_SEARCH
  AWAITING_REFERRAL_CODE
  AWAITING_REDEEM_UPLOAD
  AWAITING_USDT_TX_HASH
  AWAITING_BINANCE_ORDER_ID
}

enum AccountRedeemBatchStatus {
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

enum TelegramUpdateStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_WAITING_STOCK
  PAID
  FULFILLING
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderChannel {
  TELEGRAM
  WEB
}

enum WebContactType {
  EMAIL
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum UsdtBep20AttemptStatus {
  AWAITING_TX_HASH
  VERIFYING
  PENDING_CONFIRMATIONS
  VERIFIED
  CONFIRMED
  REJECTED
  EXPIRED
}

enum BinanceInternalPaymentStatus {
  AWAITING_ORDER_ID
  VERIFYING
  VERIFIED
  CONFIRMED
  REJECTED
  EXPIRED
}

enum BinanceInternalVerifierMode {
  OFFICIAL_API
  WEB_SESSION
}

enum BinanceWebSessionStatus {
  PENDING_VALIDATION
  ACTIVE
  CHALLENGED
  EXPIRED
  ERROR
  REVOKED
}

enum BinanceWebTransactionStatus {
  RECEIVED
  MATCHED
  CONFIRMED
  UNMATCHED
  AMBIGUOUS
  REJECTED
}

enum JagoTransferStatus {
  AWAITING_TRANSFER
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum QrisInvoiceAttemptStatus {
  AWAITING_PAYMENT
  MATCHED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum QrisInvoiceEvidenceMode {
  ANDROID_NOTIFICATION
  WEB_SESSION
}

enum ShopeePartnerSessionStatus {
  PENDING_VALIDATION
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum ShopeePartnerTransactionStatus {
  RECEIVED
  MATCHED
  CONFIRMED
  UNMATCHED
  AMBIGUOUS
  REJECTED
}

enum WalletTopupStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum WalletTransactionType {
  TOPUP_CREDIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  PURCHASE_DEBIT
  PAYMENT_RELEASE_REFUND
  DELIVERY_REFUND
  STOCK_UNAVAILABLE_REFUND
  PREORDER_CANCEL_REFUND
  SMS_PURCHASE_DEBIT
  SMS_PURCHASE_REFUND
  REFERRAL_REWARD
  REFERRAL_JOIN_BONUS
}

enum ReferralAttributionStatus {
  REWARDED
}

enum SmsPoolCustomerOrderStatus {
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentClaimStatus {
  PENDING
  REGISTERED
  LOCAL_ONLY
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
}

enum BridgeEventStatus {
  RECEIVED
  CONFIRMED
  DUPLICATE
  REJECTED
}

enum TelegramNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  MANUAL_REVIEW
}

enum DeliveryReceiptStatus {
  READY
  SENDING
  SENT
  FAILED
  UNKNOWN
}

enum DeliveryChannel {
  TELEGRAM
  WEB
}

model Product {
  id                         String                 @id @default(cuid())
  sellerId                   String?
  seller                     SellerAccount?         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  groupId                    String?
  group                      ProductGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  slug                       String                 @unique
  name                       String
  variantLabel               String?
  groupSortOrder             Int                    @default(0)
  description                String                 @db.Text
  descriptionEntities        Json                   @default("[]")
  descriptionEn              String?                @db.Text
  descriptionEntitiesEn      Json                   @default("[]")
  price                      Int
  imageUrl                   String?
  attachmentOriginalFilename String?
  attachmentMimeType         String?
  attachmentEncryptedPayload String?                @db.Text
  attachmentEncryptionIv     String?
  attachmentEncryptionTag    String?
  attachmentUpdatedAt        DateTime?
  postDeliveryInstructions   String?                @db.Text
  postDeliveryEntities       Json                   @default("[]")
  redeemUrl                  String?
  status                     ProductStatus          @default(ACTIVE)
  bannedStockPolicy          BannedStockPolicy      @default(BLOCKED)
  preorderEnabled            Boolean                @default(false)
  preorderEtaText            String?
  preorderLimit              Int?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  stockItems                 DigitalStockItem[]
  webCartItems               WebCartItem[]
  orderItems                 OrderItem[]
  notifications              TelegramNotification[]
  ratings                    ProductRating[]

  @@index([groupId, status, groupSortOrder, createdAt])
  @@index([status, createdAt])
  @@index([bannedStockPolicy, status])
  @@index([createdAt])
}

enum SellerStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model SellerAccount {
  id            String @id @default(cuid())
  slug          String @unique
  displayName   String
  status        SellerStatus @default(INVITED)
  commissionBps Int @default(0)
  policyVersion Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   SellerMembership[]
  products      Product[]
  ratings       SellerRating[]
  drafts        SellerProductDraft[]
  invitations   SellerInvitation[]
  payoutAccounts SellerPayoutAccount[]
  withdrawals   SellerWithdrawal[]
  journals      SellerJournal[]
  sales         SellerSale[]
  audit         SellerAudit[]
  wallet        SellerWallet?
}

model SellerInvitation {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  emailHash String
  expiresAt DateTime
  acceptedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([sellerId, expiresAt])
}

model SellerWallet {
  sellerId String @id
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  pending BigInt @default(0)
  available BigInt @default(0)
  held BigInt @default(0)
  debt BigInt @default(0)
  updatedAt DateTime @updatedAt
}

model SellerJournal {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sourceKey String @unique
  kind String
  pending BigInt @default(0)
  available BigInt @default(0)
  held BigInt @default(0)
  debt BigInt @default(0)
  clearing BigInt @default(0)
  actor String
  reason String
  createdAt DateTime @default(now())
  @@index([sellerId, createdAt])
}

model SellerPayoutAccount {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  bank String
  holder String
  masked String
  encryptedPayload String @db.Text
  encryptionIv String
  encryptionTag String
  status String @default("PENDING")
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  withdrawals SellerWithdrawal[]
  @@index([sellerId, status])
}

model SellerWithdrawal {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  accountId String
  account SellerPayoutAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount BigInt
  status String @default("REQUESTED")
  requestKey String
  version Int @default(1)
  operator String?
  reference String? @unique
  reason String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sellerId, requestKey])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model SellerSale {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  gross BigInt
  commission BigInt
  net BigInt
  status String @default("PENDING")
  holdSeconds Int
  eligibleAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sellerId, status, createdAt])
}

model SellerAudit {
  id String @id @default(cuid())
  sellerId String
  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  actor String
  action String
  target String
  detail String
  createdAt DateTime @default(now())
  @@index([sellerId, createdAt])
}

enum SellerDraftStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model SellerProductDraft {
  id          String @id @default(cuid())
  sellerId    String
  seller      SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  name        String
  description String @db.Text
  price       Int
  status      SellerDraftStatus @default(DRAFT)
  revision    Int @default(1)
  reviewReason String?
  reviewedBy  String?
  publishedProductId String? @unique
  targetProductId String?
  requestKey  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([sellerId, requestKey])
  @@index([sellerId, status, updatedAt])
}

model SellerMembership {
  id          String @id @default(cuid())
  sellerId    String @unique
  seller      SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  clerkIssuer String
  clerkUserId String
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  @@unique([clerkIssuer, clerkUserId])
}

model ProductRating {
  id          String @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId  String
  customer    WebCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItemId String @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderId     String
  stars       Int
  review      String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([productId, createdAt])
  @@unique([orderId, productId])
}

model SellerRating {
  id          String @id @default(cuid())
  sellerId    String
  seller      SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  customerId  String
  customer    WebCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId     String @unique
  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stars       Int
  review      String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([sellerId, createdAt])
}

model ProductGroup {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  name                  String
  description           String        @db.Text
  descriptionEntities   Json          @default("[]")
  descriptionEn         String?       @db.Text
  descriptionEntitiesEn Json          @default("[]")
  imageUrl              String?
  status                ProductStatus @default(ACTIVE)
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  products              Product[]

  @@index([status, sortOrder, createdAt])
  @@index([createdAt])
}

model DigitalStockItem {
  id                     String               @id @default(cuid())
  productId              String
  product                Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  originalFilename       String
  credentialFingerprint  String               @unique
  encryptedPayload       String               @db.Text
  encryptionIv           String
  encryptionTag          String
  status                 DigitalStockStatus   @default(AVAILABLE)
  healthStatus           StockHealthStatus    @default(UNKNOWN)
  healthHttpStatus       Int?
  healthError            String?
  quotaSnapshot          Json?
  lastCheckedAt          DateTime?
  bannedSaleApprovedAt   DateTime?
  bannedSaleApprovedBy   String?
  bannedSaleApprovalNote String?
  reservedOrderId        String?
  reservedAt             DateTime?
  deliveredOrderId       String?
  deliveredAt            DateTime?
  archivedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  orderItem              OrderItem?
  deliveryReceipt        SentDelivery?        @relation("DeliveredStock")
  accountRedeemEvents    AccountRedeemEvent[]

  @@index([productId, status, healthStatus])
  @@index([productId, healthStatus, bannedSaleApprovedAt])
  @@index([productId, createdAt])
  @@index([archivedAt, status, createdAt])
  @@index([reservedOrderId])
  @@index([deliveredOrderId])
}

model BotSession {
  chatId                   String          @id
  state                    BotSessionState @default(BROWSING)
  locale                   String          @default("id")
  cart                     Json?
  buyerEmail               String?
  buyerUsername            String?
  buyerDisplayName         String?
  broadcastEnabled         Boolean         @default(true)
  telegramReachable        Boolean         @default(true)
  checkoutKey              String?
  activeOrderId            String?
  navigationMessageId      Int?
  catalogSearchQuery       String?
  smsSearchQuery           String?
  lastInboundAt            DateTime        @default(now())
  reengagementLastQueuedAt DateTime?
  reengagementSequence     Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([telegramReachable, lastInboundAt, reengagementSequence, chatId], map: "BotSession_reengagement_eligibility_idx")
  @@index([reengagementLastQueuedAt, lastInboundAt])
}

model Wallet {
  chatId           String                 @id
  balance          Int                    @default(0)
  buyerUsername    String?
  buyerDisplayName String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     WalletTransaction[]
  topups           WalletTopup[]
  smsPoolOrders    SmsPoolCustomerOrder[]

  @@index([balance, updatedAt])
  @@index([buyerUsername])
  @@index([updatedAt])
}

model SmsPoolCustomerOrder {
  id                   String                     @id @default(cuid())
  idempotencyKey       String                     @unique
  chatId               String
  wallet               Wallet                     @relation(fields: [chatId], references: [chatId], onDelete: Restrict)
  buyerUsername        String?
  buyerDisplayName     String?
  providerOrderId      String?                    @unique
  countryId            Int
  countryName          String
  countryCode          String?
  serviceId            Int
  serviceName          String
  providerCostUsdCents Int
  sellPrice            Int
  phoneNumber          String?
  otpCode              String?
  fullCode             String?
  providerStatus       String?
  status               SmsPoolCustomerOrderStatus @default(PROCESSING)
  expiresAt            DateTime?
  completedAt          DateTime?
  refundedAt           DateTime?
  lastCheckedAt        DateTime?
  failureReason        String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([chatId, createdAt])
  @@index([status, expiresAt])
  @@index([buyerUsername, createdAt])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletChatId   String
  wallet         Wallet                @relation(fields: [walletChatId], references: [chatId], onDelete: Restrict)
  type           WalletTransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  idempotencyKey String                @unique
  orderId        String?
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  walletTopupId  String?
  walletTopup    WalletTopup?          @relation(fields: [walletTopupId], references: [id], onDelete: Restrict)
  note           String?
  actor          String?
  createdAt      DateTime              @default(now())

  @@index([walletChatId, createdAt])
  @@index([orderId])
  @@index([walletTopupId])
  @@index([type, createdAt])
}

model WalletTopup {
  id                       String                  @id @default(cuid())
  idempotencyKey           String                  @unique
  invoiceNumber            String                  @unique
  chatId                   String
  wallet                   Wallet                  @relation(fields: [chatId], references: [chatId], onDelete: Restrict)
  paymentMethod            String                  @default("DANA_RELAY")
  baseAmount               Int
  uniqueCode               Int
  billedAmount             Int
  status                   WalletTopupStatus       @default(PENDING)
  verifiedBy               String?
  verifiedAt               DateTime?
  telegramInvoiceMessageId Int?
  expiresAt                DateTime
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  bridgeClaim              BridgePaymentClaim?
  jagoTransferAttempt      JagoWalletTopupAttempt?
  qrisInvoiceAttempt       QrisInvoiceAttempt?
  bridgeEvents             BridgePaymentEvent[]
  notifications            TelegramNotification[]
  transactions             WalletTransaction[]

  @@index([chatId, createdAt])
  @@index([status, uniqueCode, expiresAt])
  @@index([status, billedAmount, expiresAt])
  @@index([billedAmount, status, createdAt, expiresAt])
  @@index([paymentMethod, status, billedAmount, expiresAt])
  @@index([uniqueCode, expiresAt])
  @@index([createdAt])
}

model JagoWalletTopupAttempt {
  id                             String             @id @default(cuid())
  walletTopupId                  String             @unique
  walletTopup                    WalletTopup        @relation(fields: [walletTopupId], references: [id], onDelete: Restrict)
  recipientAccountNumberSnapshot String
  status                         JagoTransferStatus @default(AWAITING_TRANSFER)
  matchedEventId                 String?            @unique
  matchedAt                      DateTime?
  expiresAt                      DateTime
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  @@index([status, expiresAt])
  @@index([createdAt])
}

model TelegramProcessedUpdate {
  updateId   BigInt               @id
  chatId     String
  status     TelegramUpdateStatus @default(PROCESSING)
  attempts   Int                  @default(1)
  leaseUntil DateTime
  lastError  String?
  expiresAt  DateTime
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, leaseUntil])
  @@index([expiresAt])
}

model Order {
  id                            String                         @id @default(cuid())
  idempotencyKey                String                         @unique
  invoiceNumber                 String                         @unique
  chatId                        String
  channel                       OrderChannel                   @default(TELEGRAM)
  webCustomerId                 String?
  webCustomer                   WebCustomer?                   @relation(fields: [webCustomerId], references: [id], onDelete: Restrict)
  buyerEmail                    String?
  buyerUsername                 String?
  buyerDisplayName              String?
  subtotal                      Int
  serviceFee                    Int
  grandTotal                    Int
  status                        OrderStatus                    @default(PENDING_PAYMENT)
  paymentStatus                 PaymentStatus                  @default(PENDING)
  isPreorder                    Boolean                        @default(false)
  preorderEtaText               String?
  waitingStockAt                DateTime?
  expiresAt                     DateTime
  stockReleasedAt               DateTime?
  paidAt                        DateTime?
  completedAt                   DateTime?
  refundedAt                    DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  items                         OrderItem[]
  payment                       Payment?
  usdtBep20Attempt              UsdtBep20Attempt?
  binanceInternalPaymentAttempt BinanceInternalPaymentAttempt?
  jagoTransferAttempt           JagoTransferAttempt?
  qrisInvoiceAttempt            QrisInvoiceAttempt?
  bridgeClaim                   BridgePaymentClaim?
  bridgeEvents                  BridgePaymentEvent[]
  notifications                 TelegramNotification[]
  deliveryReceipts              SentDelivery[]
  walletTransactions            WalletTransaction[]
  accountRedeemEvents           AccountRedeemEvent[]
  sellerRatings                 SellerRating[]

  @@index([chatId, createdAt])
  @@index([chatId, status, expiresAt])
  @@index([webCustomerId, createdAt])
  @@index([channel, status, createdAt])
  @@index([buyerUsername, createdAt])
  @@index([status, expiresAt])
  @@index([paymentStatus, expiresAt])
  @@index([isPreorder, status, paidAt])
}

model WebCustomer {
  id                  String               @id @default(cuid())
  contactType         WebContactType       @default(EMAIL)
  contactLookupHash   String               @unique
  contactMasked       String
  passwordHash        String
  clerkIssuer         String?
  clerkUserId         String?
  clerkLinkedAt       DateTime?
  failedAttempts      Int                  @default(0)
  lockedUntil         DateTime?
  lastAuthenticatedAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  sessions            WebCustomerSession[]
  cart                WebCart?
  productRatings      ProductRating[]
  sellerRatings       SellerRating[]

  @@index([createdAt])
  @@index([lockedUntil])
  @@unique([clerkIssuer, clerkUserId])
}

model WebCustomerSession {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  webCustomerId String
  webCustomer   WebCustomer @relation(fields: [webCustomerId], references: [id], onDelete: Restrict)
  userAgentHash String?
  expiresAt     DateTime
  lastUsedAt    DateTime    @default(now())
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([webCustomerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model WebCart {
  webCustomerId String @id
  webCustomer WebCustomer @relation(fields: [webCustomerId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items WebCartItem[]
  mutations WebCartMutation[]
}

model WebCartItem {
  id String @id @default(cuid())
  webCustomerId String
  cart WebCart @relation(fields: [webCustomerId], references: [webCustomerId], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([webCustomerId, productId])
  @@index([productId])
}

model WebCartMutation {
  webCustomerId String
  cart WebCart @relation(fields: [webCustomerId], references: [webCustomerId], onDelete: Cascade)
  idempotencyKey String
  payloadHash String
  createdAt DateTime @default(now())
  @@id([webCustomerId, idempotencyKey])
  @@index([webCustomerId, createdAt])
}

model UsdtBep20Attempt {
  id                            String                 @id @default(cuid())
  orderId                       String                 @unique
  order                         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rateSnapshot                  Int
  baseUsdtMicros                BigInt
  uniqueMicros                  Int
  expectedUsdtMicros            BigInt
  expectedTokenUnits            Decimal                @db.Decimal(78, 0)
  recipientAddressSnapshot      String
  tokenContractSnapshot         String
  tokenDecimalsSnapshot         Int
  chainIdSnapshot               Int                    @default(56)
  requiredConfirmationsSnapshot Int
  status                        UsdtBep20AttemptStatus @default(AWAITING_TX_HASH)
  txHash                        String?                @unique
  transferLogIndex              Int?
  blockNumber                   BigInt?
  blockTimestamp                DateTime?
  confirmations                 Int?
  submittedAt                   DateTime?
  lastCheckedAt                 DateTime?
  verifiedAt                    DateTime?
  confirmedAt                   DateTime?
  failureReason                 String?                @db.Text
  expiresAt                     DateTime
  verificationExpiresAt         DateTime
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@index([status, lastCheckedAt])
  @@index([status, expiresAt])
  @@index([status, verificationExpiresAt])
  @@index([expectedUsdtMicros, status])
  @@index([createdAt])
}

model BinanceInternalPaymentAttempt {
  id                                String                       @id @default(cuid())
  orderId                           String                       @unique
  order                             Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rateSnapshot                      Int
  baseUsdtMicros                    BigInt
  uniqueMicros                      Int
  expectedUsdtMicros                BigInt
  recipientBinanceIdSnapshot        String
  verifierMode                      BinanceInternalVerifierMode  @default(OFFICIAL_API)
  binanceWebSessionIdSnapshot       String?
  binanceWebSession                 BinanceWebSession?           @relation("BinanceAttemptWebSession", fields: [binanceWebSessionIdSnapshot], references: [id], onDelete: Restrict)
  binanceAccountFingerprintSnapshot String?
  status                            BinanceInternalPaymentStatus @default(AWAITING_ORDER_ID)
  submittedOrderId                  String?                      @unique
  canonicalTransactionId            String?                      @unique
  observedAmount                    Decimal?                     @db.Decimal(36, 18)
  observedCurrency                  String?
  observedOrderType                 String?
  observedProviderStatus            String?
