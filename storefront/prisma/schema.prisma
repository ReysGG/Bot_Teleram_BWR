  lastErrorAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sessionId, bucketStart], map: "BinanceWebPollMetric_session_bucket_key")
  @@index([bucketStart], map: "BinanceWebPollMetric_bucket_idx")
  @@index([sessionId, bucketStart], map: "BinanceWebPollMetric_session_bucket_idx")
}

