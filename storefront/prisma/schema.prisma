  binanceInternalPaymentAttempt   BinanceInternalPaymentAttempt? @relation(fields: [binanceInternalPaymentAttemptId], references: [id], onDelete: Restrict)
  firstSeenAt                     DateTime                       @default(now())
  confirmedAt                     DateTime?
  rejectionReason                 String?
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt

  @@unique([accountFingerprint, providerTransactionId], map: "BinanceWebTransaction_account_provider_key")
  @@index([sessionId, occurredAt], map: "BinanceWebTransaction_session_occurred_idx")
  @@index([accountFingerprint, amountMicros, occurredAt], map: "BinanceWebTransaction_account_amount_time_idx")
  @@index([providerOrderId], map: "BinanceWebTransaction_order_id_idx")
  @@index([status, occurredAt], map: "BinanceWebTransaction_status_occurred_idx")
}

model BinanceWebPollMetric {
