DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/telegram_store?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/telegram_store?sslmode=require"
DB_POOL_MAX="20"
DB_POOL_MIN="2"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"
DB_POOL_MAX_USES="5000"
DB_TRANSACTION_MAX_WAIT_MS="10000"
DB_TRANSACTION_TIMEOUT_MS="30000"
APP_URL="http://localhost:3000"

# Public storefront address shown in completed website-order announcements.
STOREFRONT_PUBLIC_URL="https://store.buildwithreys.com"

# Signed server-to-server API used by the separate storefront VPS.
STOREFRONT_API_KEY_ID="storefront-primary"
STOREFRONT_API_SHARED_SECRET="replace-with-at-least-32-random-characters"
STOREFRONT_CONTACT_LOOKUP_SECRET="replace-with-a-separate-random-secret"
STOREFRONT_SESSION_TTL_HOURS="24"
# Local disposable database only. Never enable on a public/production APP_URL.
STOREFRONT_TEST_PAYMENT_ENABLED="false"

AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
APP_CRON_SECRET="replace-with-a-random-cron-secret"
CRON_SECRET="replace-with-the-same-random-cron-secret-on-vercel"
TELEGRAM_ADMIN_CHAT_IDS=""
# Channel membership is optional. The bot never gates commerce on joining.
TELEGRAM_SHARING_CHANNEL_ID=""
TELEGRAM_SHARING_CHANNEL_URL="https://t.me/+apR5dsE0r4M4OGJl"
TELEGRAM_MAIN_CHANNEL_ID="@buildwithreys"
TELEGRAM_MAIN_CHANNEL_URL="https://t.me/buildwithreys"
TELEGRAM_SUCCESS_CHANNEL_ID=""
TELEGRAM_SUCCESS_CHANNEL_URL="https://t.me/bwrtele_success"

SMSPOOL_API_KEY=""
SMSPOOL_TIMEOUT_MS="15000"
SMSPOOL_USD_TO_IDR_RATE="18500"
SMSPOOL_SERVICE_FEE_IDR="2000"

DIGITAL_STOCK_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Separate key for encrypted payment-provider web sessions; never reuse the stock key.
PAYMENT_SESSION_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# When enabled, new QRIS invoices use the validated Shopee web session bound to
# the active merchant instead of Android-notification evidence.
SHOPEE_WEB_SESSION_CHECKOUT_ENABLED="false"
# Keep web-session financial confirmation disabled until the Shopee response
# status contract and a controlled cutover have been reviewed.
SHOPEE_WEB_SESSION_AUTO_CONFIRM="false"
# Android Shopee notifications remain a fallback only; web-session is primary.
SHOPEE_ANDROID_FALLBACK_ENABLED="true"
# Hold Android confirmation briefly so the 30-second cookie poll/matcher gets
# first priority. The signed Android event remains queued and retries afterward.
SHOPEE_ANDROID_FALLBACK_DELAY_SECONDS="90"
STOCK_REQUIRE_HEALTHY="true"
# Per-order ceiling; values above the application hard limit are clamped to 750.
ORDER_MAX_QUANTITY="750"
STOCK_HEALTHCHECK_URL="https://chatgpt.com/backend-api/wham/usage"
STOCK_HEALTHCHECK_METHOD="GET"
STOCK_HEALTHCHECK_TIMEOUT_MS="15000"
STOCK_AUTO_CHECK_ENABLED="true"
STOCK_AUTO_CHECK_INTERVAL_SECONDS="30"
STOCK_AUTO_CHECK_BATCH_SIZE="9"

# Maximum accounts in one Codex Free redeem batch; raise only with enough worker memory.
ACCOUNT_REDEEM_MAX_ITEMS="2000"

PAYMENT_EXPIRY_MINUTES="5"
USDT_BEP20_PAYMENT_EXPIRY_MINUTES="30"
PAYMENT_INSTRUCTIONS="Bayar nominal tepat melalui QRIS/DANA lalu tunggu konfirmasi otomatis."
PAYMENT_QRIS_IMAGE_URL=""
PAYMENT_QRIS_BASE_PAYLOAD=""
# Optional legacy Android bridge device IDs, comma-separated. Empty means relay-only.
DANA_ANDROID_BRIDGE_DEVICE_IDS=""

JAGO_TRANSFER_ENABLED="false"
JAGO_TRANSFER_ACCOUNT_NUMBER=""

# BNB Smart Chain JSON-RPC. The public fallback works for basic verification,
# but a dedicated RPC is recommended for reliable production polling.
BSC_RPC_URL="https://bsc-dataseed.bnbchain.org"
BSC_RPC_TIMEOUT_MS="12000"
USDT_BEP20_VERIFICATION_GRACE_MINUTES="60"

# Read-only Binance API key for signed Pay transaction history checks.
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_API_BASE_URL="https://api.binance.com"
BINANCE_PAY_RECIPIENT_ID=""
# Numeric receipt IDs and the documented M_P_ history prefix match automatically.
# Optional additional prefix for a verified provider-specific representation.
BINANCE_ORDER_ID_PREFIX=""
BINANCE_API_RECV_WINDOW_MS="5000"
BINANCE_API_TIMEOUT_MS="12000"
BINANCE_PAY_VERIFICATION_GRACE_MINUTES="60"
# Private Binance web-session verifier. Keep both gates false until a session is
# validated against the configured recipient and a controlled payment succeeds.
BINANCE_WEB_SESSION_CHECKOUT_ENABLED="false"
BINANCE_WEB_SESSION_AUTO_CONFIRM="false"
BINANCE_WEB_SESSION_POLL_TIMEOUT_MS="12000"
BINANCE_WEB_SESSION_MAX_LOOKBACK_HOURS="24"
BINANCE_WEB_SESSION_MAX_PAGES_PER_RUN="3"
BINANCE_WEB_SESSION_MAX_DETAIL_CALLS_PER_RUN="5"

DANA_BRIDGE_RELAY_URL=""
DANA_BRIDGE_STORE_ID="independent-telegram-store"
DANA_BRIDGE_RELAY_KEY_ID=""
DANA_BRIDGE_RELAY_SECRET=""
DANA_BRIDGE_CALLBACK_SECRET="replace-with-at-least-32-random-characters"
ALLOW_MANUAL_PAYMENT_WITHOUT_RELAY="true"

DANA_ANDROID_BRIDGE_ENABLED="false"
DANA_ANDROID_BRIDGE_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
DANA_ANDROID_BRIDGE_INCOMING_PHRASES=""
DANA_ANDROID_BRIDGE_EXCLUDED_PHRASES=""

# Generic aliases used by the same Android app for DANA and Bank Jago.
# When omitted, the legacy DANA_ANDROID_BRIDGE_* values remain supported.
ANDROID_PAYMENT_BRIDGE_ENABLED="false"
ANDROID_PAYMENT_BRIDGE_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# Clerk commerce is off until schema, configuration, and database integration checks are reviewed.
STOREFRONT_SMS_ENABLED="false"
STOREFRONT_CLERK_ENABLED="false"
STOREFRONT_CLERK_ISSUER="https://your-clerk-instance.example"
STOREFRONT_CLERK_JWT_KEY=""
STOREFRONT_CLERK_AUTHORIZED_PARTIES="http://localhost:3001"
# Backend-only Clerk key. Provision separately; never mount storefront env files here.
STOREFRONT_CLERK_SECRET_KEY=""
